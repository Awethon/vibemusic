# Options for the bundled Navidrome (the "navidrome" profile). Copy to navidrome.env; any ND_*
# option from https://www.navidrome.org/docs/usage/configuration-options/ works here.

# Share links. ND_SHAREURL is the public address people open them at, if you have a domain.
ND_ENABLESHARING=true
# ND_SHAREURL=https://music.example.com

# How often the music folder is rescanned.
ND_SCANSCHEDULE=1h

# Don't send anonymous usage statistics to the Navidrome project.
ND_ENABLEINSIGHTSCOLLECTOR=false

# Where artist photos, biographies and similar artists come from, in order.
# ND_AGENTS=deezer,lastfm,listenbrainz

# Lyrics: files next to the songs first, then lyrics embedded in them.
# ND_LYRICSPRIORITY=.lrc,.txt,embedded
