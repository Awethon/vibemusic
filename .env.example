# Copy to .env and adjust. Everything except COMPOSE_PROFILES is optional.

# Optional parts to run: "relay" and/or "navidrome", comma-separated.
#   relay,navidrome  a new setup with its own Navidrome
#   relay            you already run Navidrome: set NAVIDROME_URL below
COMPOSE_PROFILES=relay,navidrome

# Port on this machine for the app (and Navidrome's own UI under /app).
VIBEMUSIC_PORT=8080

# Navidrome as the containers reach it. Leave unset for the bundled one; for your own, e.g.
# http://192.168.1.10:4533 or http://navidrome:4533 on a shared Docker network.
# NAVIDROME_URL=

# Bundled Navidrome only: your music folder (read-only). For several folders, give their common
# parent. Navidrome's own options go in navidrome.env (see navidrome.env.example).
MUSIC_FOLDER=./music

# Relay: outside services it may send artist and album names to (empty for none). Navidrome's
# own lookups (artist photos, biographies) are set with ND_AGENTS in Navidrome instead.
# ENRICHMENT_SOURCES=musicbrainz,deezer,apple
# Apple catalogs to search for top songs, in order; add your country, e.g. us,de. Apple allows
# about 20 requests a minute; APPLE_PAUSE_MS is the gap between them.
# APPLE_STOREFRONTS=us
# APPLE_PAUSE_MS=3200

# Relay: a Navidrome account (not an admin) for "This is" playlists. Leave unset to turn them off.
# ./setup.sh can create one and fill these in.
# VIBEMUSIC_RELAY_NAVIDROME_USER=
# VIBEMUSIC_RELAY_NAVIDROME_PASSWORD=
# Artists that never get a "This is" playlist, comma-separated.
# THIS_IS_SKIP=
# Songs an artist needs for a playlist, songs per playlist, and hours between refreshes.
# THIS_IS_MIN_TRACKS=13
# THIS_IS_MAX_TRACKS=50
# THIS_IS_EVERY_HOURS=168

# Relay: internet radio stations on .local (mDNS) hosts, which containers usually can't resolve,
# are fetched through a proxy you run on the host network, at this address.
# RADIO_LOCAL_PROXY=

# Relay log level: error, warn, info or debug.
# RELAY_LOG=info

# Genre playlists (lists are comma-separated genre names).
# VIBEMUSIC_GENRE_HIDDEN=
# VIBEMUSIC_GENRE_PINNED=
# VIBEMUSIC_GENRE_MAX_PLAYLISTS=24
# VIBEMUSIC_GENRE_SONG_CAP=100
# VIBEMUSIC_GENRE_MIN_SONGS=
# VIBEMUSIC_GENRE_MIN_ARTISTS=

# Defaults for visitors who haven't changed a setting themselves. Allowed values above each.
# field | amber (caustics)
# VIBEMUSIC_DEFAULT_BACKGROUND=field
# on | off
# VIBEMUSIC_DEFAULT_RIPPLES=off
# minimal | classic
# VIBEMUSIC_DEFAULT_FULL_SCREEN=minimal
# open | mini
# VIBEMUSIC_DEFAULT_SIDEBAR=mini
# list | grid
# VIBEMUSIC_DEFAULT_ARTIST_VIEW=list
# on | off
# VIBEMUSIC_DEFAULT_TIMELINE=on
# on | off
# VIBEMUSIC_DEFAULT_RADIO=on
# on | off
# VIBEMUSIC_DEFAULT_GLASS=off
# default | clear | frosted | prism | pebble | bubble | slab, or a look code from the glass page
# VIBEMUSIC_DEFAULT_GLASS_LOOK=default
